{
  "name": "@az-digital/components-react-bootstrap",
  "version": "0.0.1",
  "description": "React components implementing the Arizona Digital design system, with React Bootstrap where it supplies the behavior.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./storybook": "./storybook/adapter.tsx",
    "./package.json": "./package.json",
    "./ArizonaHeader": {
      "types": "./dist/ArizonaHeader.d.ts",
      "import": "./dist/ArizonaHeader.js",
      "require": "./dist/ArizonaHeader.cjs"
    },
    "./Button": {
      "types": "./dist/Button.d.ts",
      "import": "./dist/Button.js",
      "require": "./dist/Button.cjs"
    },
    "./Accordion": {
      "types": "./dist/Accordion.d.ts",
      "import": "./dist/Accordion.js",
      "require": "./dist/Accordion.cjs"
    },
    "./Tabs": {
      "types": "./dist/Tabs.d.ts",
      "import": "./dist/Tabs.js",
      "require": "./dist/Tabs.cjs"
    },
    "./Nav": {
      "types": "./dist/Nav.d.ts",
      "import": "./dist/Nav.js",
      "require": "./dist/Nav.cjs"
    }
  },
  "files": [
    "dist",
    "storybook",
    "README.md",
    "!dist/**/*.map"
  ],
  "keywords": [
    "design-system",
    "react",
    "components",
    "az-digital"
  ],
  "author": "Arizona Digital",
  "license": "MIT",
  "azDesign": {
    "library": {
      "key": "react",
      "title": "React Bootstrap",
      "status": "preview",
      "codeLanguage": "jsx",
      "readme": "./README.md",
      "stylesheets": [
        "https://cdn.digital.arizona.edu/lib/arizona-bootstrap/latest-5.x/css/arizona-bootstrap.css"
      ],
      "adapter": "./storybook"
    }
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "react-bootstrap": "^2.10.10"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@az-digital/storybook-addon-libraries": "*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
