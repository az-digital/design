                }
              }
            }
          }
        },
        "white-text-blue": {
          "description": "White with Blue text, on Arroyo Blue. Arizona Bootstrap: .btn-white-text-blue.",
          "anatomy": {
            "root": {
              "tokens": {
                "fill": "{az.color.bg.button.white}",
                "border.color": "{az.color.bg.button.white}"
              },
              "states": {
                "hover": {
                  "fill": "{az.color.bg.button.white-hover}",
                  "border.color": "{az.color.bg.button.white-hover}"
                },
                "focus-visible": {
                  "fill": "{az.color.bg.button.white-hover}",
                  "border.color": "{az.color.bg.button.white-hover}",
                  "ring.color": "{az.color.brand.white}"
                }
              },
              "parts": {
                "label": {
                  "tokens": {
                    "color": "{az.color.fg.blue}"
                  },
                  "states": {
                    "hover": {
                      "color": "{az.color.fg.blue}"
                    },
                    "focus-visible": {
                      "color": "{az.color.fg.blue}"
                    }
                  }
                }
              }
            }
          }
        },
        "outline-white": {
          "description": "A White outline, on Red or Arroyo Blue. It fills White with Gray 800 text on hover. Arizona Bootstrap: .btn-outline-white.",
          "anatomy": {
            "root": {
              "tokens": {
                "border.color": "{az.color.brand.white}"
              },
              "states": {
                "hover": {
                  "fill": "{az.color.brand.white}",
                  "border.color": "{az.color.brand.white}"
                },
                "focus-visible": {
                  "fill": "{az.color.brand.white}",
                  "border.color": "{az.color.brand.white}",
                  "ring.color": "{az.color.brand.white}"
                }
              },
              "parts": {
                "label": {
                  "tokens": {
                    "color": "{az.color.fg.white}"
                  },
                  "states": {
                    "hover": {
                      "color": "{az.color.brand.gray.800}"
                    },
                    "focus-visible": {
                      "color": "{az.color.brand.gray.800}"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "anatomy": {
    "root": {
      "description": "The button: its shape, border and padding. Its colors come from its color variant. A button that's only an icon keeps the same height.",
      "tokens": {
        "padding.y": {
          "$type": "dimension",
          "$value": {
            "value": 9,
            "unit": "px"
          },
          "$description": "Button top and bottom padding, so with its 24px line and 2px border the button is 46px tall."
        },
        "padding.x": {
          "$type": "dimension",
          "$value": {
            "value": 28,
            "unit": "px"
          },
          "$description": "Button left and right padding."
        },
        "border.width": {
          "$type": "dimension",
          "$value": {
            "value": 2,
            "unit": "px"
          },
          "$description": "Button border width, on every color, so outline and solid buttons are the same size."
        },
        "border.radius": {
          "$type": "dimension",
          "$value": {
            "value": 256,
            "unit": "px"
          },
          "$description": "Button corner radius: fully rounded ends (a pill) at every size."
        },
        "gap": {
          "$type": "dimension",
          "$value": {
            "value": 4,
            "unit": "px"
          },
          "$description": "Space between the label and an icon."
        },
        "transition.duration": {
          "$type": "duration",
          "$value": {
            "value": 150,
            "unit": "ms"
          },
          "$description": "How long a button takes to change color on hover and focus. Not yet reviewed by design. Turned off when someone asks for reduced motion."
        },
        "transition.easing": {
          "$type": "cubicBezier",
          "$value": [
            0.42,
            0,
            0.58,
            1
          ],
          "$description": "Easing for a button's color changes. Not yet reviewed by design. Turned off when someone asks for reduced motion."
        }
      },
      "states": {
        "focus-visible": {
          "ring.width": "{az.focus-ring.width.md}",
          "ring.offset": {
            "$type": "dimension",
            "$value": {
              "value": 2,
              "unit": "px"
            },
            "$description": "Gap between the button and its keyboard focus ring."
          }
        }
      },
      "parts": {
        "label": {
          "description": "The button's text.",
          "tokens": {
            "font.family": {
              "$type": "fontFamily",
              "$value": [
                "proxima-nova-condensed",
                "Proxima Nova Condensed",
                "proxima-nova",
                "calibri",
                "sans-serif"
              ],
              "$description": "Button label typeface: Proxima Nova Condensed."
            },
            "font.weight": {
              "$type": "fontWeight",
              "$value": 700,
              "$description": "Button label weight (Bold)."
            },
            "font.size": {
              "$type": "dimension",
              "$value": {
                "value": 18,
                "unit": "px"
              },
              "$description": "Button label text size."
            },
            "line-height": {
              "$type": "dimension",
              "$value": {
                "value": 24,
                "unit": "px"
              },
              "$description": "Button label line height."
            },
            "letter-spacing": {
              "$type": "dimension",
              "$value": {
                "value": 0.14,
                "unit": "px"
              },
              "$description": "Button label letter spacing."
            }
          }
        }
      }
    }
  }
}
