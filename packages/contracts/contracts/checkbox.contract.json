{
  "$schema": "../contract.schema.json",
  "id": "checkbox",
  "name": "Checkbox",
  "description": "A box to turn one option on or off, beside its label. An 18px White box with a Gray 600 border, filled Red with a White check when it's checked, or a White dash when it's indeterminate.",
  "sources": [
    "Arizona Bootstrap's latest 5.x release: .form-check and .form-check-input[type=checkbox]"
  ],
  "anatomy": {
    "root": {
      "description": "The checkbox and its label, side by side.",
      "tokens": {
        "padding.left": {
          "$type": "dimension",
          "$value": {
            "value": 27,
            "unit": "px"
          },
          "$description": "Space from the checkbox's left edge to its label: the 18px box and 9px after it."
        },
        "min-height": {
          "$type": "dimension",
          "$value": {
            "value": 28,
            "unit": "px"
          },
          "$description": "At least one line of label text tall: 28px."
        },
        "margin.bottom": "{az.spacing.025}"
      },
      "parts": {
        "input": {
          "description": "The box. When it's checked and has keyboard focus, its checked colors stay and only the focus ring shows focus: a checked box keeps its Red border.",
          "tokens": {
            "size": {
              "$type": "dimension",
              "$value": {
                "value": 18,
                "unit": "px"
              },
              "$description": "Checkbox width and height: 18px, the size of the label text."
            },
            "fill": "{az.color.brand.white}",
            "border.width": "{az.border.width.sm}",
            "border.color": "{az.color.brand.gray.600}",
            "border.radius": {
              "$type": "dimension",
              "$value": {
                "value": 4.5,
                "unit": "px"
              },
              "$description": "Checkbox corner radius: a quarter of the 18px box."
            },
            "margin.top": {
              "$type": "dimension",
              "$value": {
                "value": 5,
                "unit": "px"
              },
              "$description": "Space above the box, so it lines up with the first line of its label."
            }
          },
          "states": {
            "focus-visible": {
              "border.color": "{az.color.brand.bougainvillea}",
              "ring.color": "{az.color.brand.bougainvillea}",
              "ring.width": "{az.focus-ring.width.lg}",
              "ring.opacity": "{az.focus-ring.opacity}"
            },
            "checked": {
              "fill": "{az.color.brand.red}",
              "border.color": "{az.color.brand.red}"
            },
            "indeterminate": {
              "fill": "{az.color.brand.red}",
              "border.color": "{az.color.brand.red}"
            },
            "active": {
              "brightness": {
                "$type": "number",
                "$value": 0.9,
                "$description": "The box darkens to 90% brightness while it's pressed."
              }
            },
            "disabled": {
              "opacity": {
                "$type": "number",
                "$value": 0.5,
                "$description": "A disabled box and its label are at 50% opacity."
              }
            }
          },
          "parts": {
            "mark": {
              "description": "The check, or the dash when it's indeterminate.",
              "states": {
                "checked": {
                  "color": "{az.color.fg.white}"
                },
                "indeterminate": {
                  "color": "{az.color.fg.white}"
                }
              }
            }
          }
        },
        "label": {
          "description": "The checkbox's label, to its right.",
          "tokens": {
            "font.size": "{az.font-size.base}",
            "line-height": {
              "$type": "number",
              "$value": 1.5556,
              "$description": "Label line height: 28px on 18px text."
            },
            "color": "{az.color.brand.gray.900}"
          },
          "states": {
            "disabled": {
              "opacity": {
                "$type": "number",
                "$value": 0.5,
                "$description": "A disabled control's label is at 50% opacity."
              }
            }
          }
        }
      }
    }
  }
}
