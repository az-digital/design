{
  "$schema": "../contract.schema.json",
  "id": "input-group",
  "name": "Input Group",
  "description": "A text field with something attached: a text add-on such as @ or a currency sign, a button such as Subscribe, or both. The field, add-ons and buttons share one height and border, and where two touch their corners are square, so they read as one control. Gray 900 text on White with a Gray 600 border, and a Bougainvillea focus ring.",
  "sources": [
    "Arizona Bootstrap's latest 5.x release: .form-control, .input-group-text and .input-group .btn"
  ],
  "variants": {
    "size": {
      "description": "The input group's size. With none chosen, it's the default size: 6 / 12px padding, 18px text and 6px corners, about 42px tall.",
      "options": {
        "small": {
          "description": "A small input group, about 34.5px tall: .input-group-sm, or .form-control-sm on a field on its own. The field, add-ons and button all change.",
          "anatomy": {
            "root": {
              "parts": {
                "field": {
                  "tokens": {
                    "padding.y": "{az.spacing.050}",
                    "padding.x": "{az.spacing.100}",
                    "border.radius": "{az.radius.1}",
                    "font.size": {
                      "$type": "dimension",
                      "$value": {
                        "value": 15.75,
                        "unit": "px"
                      },
                      "$description": "Small input group text size: 15.75px, seven eighths of the 18px body text."
                    }
                  }
                },
                "addon": {
                  "tokens": {
                    "padding.y": "{az.spacing.050}",
                    "padding.x": "{az.spacing.100}",
                    "border.radius": "{az.radius.1}",
                    "font.size": {
                      "$type": "dimension",
                      "$value": {
                        "value": 15.75,
                        "unit": "px"
                      },
                      "$description": "Small input group text size: 15.75px, seven eighths of the 18px body text."
                    }
                  }
                },
                "button": {
                  "tokens": {
                    "padding.y": "{az.spacing.050}",
                    "padding.x": "{az.spacing.100}",
                    "border.radius": "{az.radius.1}",
                    "font.size": {
                      "$type": "dimension",
                      "$value": {
                        "value": 15.75,
                        "unit": "px"
                      },
                      "$description": "Small input group text size: 15.75px, seven eighths of the 18px body text."
                    }
                  }
                }
              }
            }
          }
        },
        "large": {
          "description": "A large input group, about 49px to 53px tall: .input-group-lg, or .form-control-lg on a field on its own. The field, add-ons and button all change.",
          "anatomy": {
            "root": {
              "parts": {
                "field": {
                  "tokens": {
                    "padding.y": "{az.spacing.100}",
                    "padding.x": "{az.spacing.200}",
                    "border.radius": "{az.radius.3}",
                    "font.size": {
                      "$type": "dimension",
                      "$value": {
                        "value": 20.25,
                        "unit": "px"
                      },
                      "$description": "Large input group text size below the xl breakpoint (1200px): 20.25px plus 0.1875% of the screen width, so it grows to 22.5px at 1200px."
                    }
                  },
                  "breakpoints": {
                    "xl": {
                      "font.size": {
                        "$type": "dimension",
                        "$value": {
                          "value": 22.5,
                          "unit": "px"
                        },
                        "$description": "Large input group text size from the xl breakpoint (1200px) up: 22.5px, one and a quarter times the 18px body text."
                      }
                    }
                  }
                },
                "addon": {
                  "tokens": {
                    "padding.y": "{az.spacing.100}",
                    "padding.x": "{az.spacing.200}",
                    "border.radius": "{az.radius.3}",
                    "font.size": {
                      "$type": "dimension",
                      "$value": {
                        "value": 20.25,
                        "unit": "px"
                      },
                      "$description": "Large input group text size below the xl breakpoint (1200px): 20.25px plus 0.1875% of the screen width, so it grows to 22.5px at 1200px."
                    }
                  },
                  "breakpoints": {
                    "xl": {
                      "font.size": {
                        "$type": "dimension",
                        "$value": {
                          "value": 22.5,
                          "unit": "px"
                        },
                        "$description": "Large input group text size from the xl breakpoint (1200px) up: 22.5px, one and a quarter times the 18px body text."
                      }
                    }
                  }
                },
                "button": {
                  "tokens": {
                    "padding.y": "{az.spacing.100}",
                    "padding.x": "{az.spacing.200}",
                    "border.radius": "{az.radius.3}",
                    "font.size": {
                      "$type": "dimension",
                      "$value": {
                        "value": 20.25,
                        "unit": "px"
                      },
                      "$description": "Large input group text size below the xl breakpoint (1200px): 20.25px plus 0.1875% of the screen width, so it grows to 22.5px at 1200px."
                    }
                  },
                  "breakpoints": {
                    "xl": {
                      "font.size": {
                        "$type": "dimension",
                        "$value": {
                          "value": 22.5,
                          "unit": "px"
                        },
                        "$description": "Large input group text size from the xl breakpoint (1200px) up: 22.5px, one and a quarter times the 18px body text."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "anatomy": {
    "root": {
      "description": "The field and whatever is attached to it, side by side.",
      "parts": {
        "field": {
          "description": "The text field.",
          "tokens": {
            "padding.y": "{az.spacing.075}",
            "padding.x": "{az.spacing.150}",
            "font.size": {
              "$type": "dimension",
              "$value": {
                "value": 18,
                "unit": "px"
              },
              "$description": "Text size in the field and add-ons: 18px, the body text size on a site."
            },
            "font.weight": "{az.font-weight.normal}",
            "line-height": {
              "$type": "number",
              "$value": 1.5556,
              "$description": "Line height of the field's and add-ons' text: 28px on 18px text."
            },
            "color": "{az.color.brand.gray.900}",
            "border.width": "{az.border.width.sm}",
            "border.color": "{az.color.brand.gray.600}",
            "border.radius": "{az.radius.2}",
            "fill": "{az.color.brand.white}",
            "placeholder.color": "{az.color.brand.gray.900}",
            "placeholder.opacity": {
              "$type": "number",
              "$value": 0.75,
              "$description": "Placeholder text opacity, so it reads as lighter than typed text."
            },
            "transition.duration": {
              "$type": "duration",
              "$value": {
                "value": 150,
                "unit": "ms"
              },
              "$description": "How long the field's border and focus ring take to change. Not yet reviewed by design. Turned off when someone asks for reduced motion."
            },
            "transition.easing": {
              "$type": "cubicBezier",
              "$value": [
                0.42,
                0,
                0.58,
                1
              ],
              "$description": "Easing for the field's border and focus ring changes. Not yet reviewed by design. Turned off when someone asks for reduced motion."
            }
          },
          "states": {
            "focus-visible": {
              "border.color": "{az.color.brand.bougainvillea}",
              "ring.color": "{az.color.brand.bougainvillea}",
              "ring.width": "{az.focus-ring.width.lg}",
              "ring.opacity": {
                "$type": "number",
                "$value": 0.7,
                "$description": "Opacity of the field's focus ring, so the page shows through it."
              }
            },
            "disabled": {
              "fill": "{az.color.brand.gray.200}",
              "border.color": "{az.color.brand.gray.400}"
            }
          }
        },
        "addon": {
          "description": "Optional text or an icon beside the field, such as @ or a currency sign.",
          "tokens": {
            "padding.y": "{az.spacing.075}",
            "padding.x": "{az.spacing.150}",
            "font.size": {
              "$type": "dimension",
              "$value": {
                "value": 18,
                "unit": "px"
              },
              "$description": "Text size in the field and add-ons: 18px, the body text size on a site."
            },
            "font.weight": "{az.font-weight.normal}",
            "line-height": {
              "$type": "number",
              "$value": 1.5556,
              "$description": "Line height of the field's and add-ons' text: 28px on 18px text."
            },
            "color": "{az.color.brand.gray.900}",
            "border.width": "{az.border.width.sm}",
            "border.color": "{az.color.brand.gray.600}",
            "border.radius": "{az.radius.2}",
            "fill": "{az.color.brand.gray.100}"
          }
        },
        "button": {
          "description": "An attached Button, in any of the Button's colors. Its colors and type come from the Button contract; the input group sets its padding, border and corners to match the field.",
          "tokens": {
            "padding.y": "{az.spacing.075}",
            "padding.x": "{az.spacing.150}",
            "border.width": "{az.border.width.sm}",
            "border.radius": "{az.radius.2}"
          }
        }
      }
    }
  }
}
