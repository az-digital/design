{
  "$schema": "../contract.schema.json",
  "id": "nav",
  "name": "Nav",
  "description": "A list of links for navigation. This initial contract records Arizona Bootstrap 5.3.0 link spacing; additional states and visual decisions still need review.",
  "sources": [
    "Arizona Bootstrap 5.3.0 navs and tabs: https://digital.arizona.edu/arizona-bootstrap/v5/docs/5.3/components/navs-tabs/"
  ],
  "anatomy": {
    "root": {
      "description": "The navigation link list.",
      "parts": {
        "link": {
          "description": "A navigation link.",
          "tokens": {
            "padding.x": "{az.spacing.200}",
            "padding.y": "{az.spacing.100}"
          }
        }
      }
    }
  },
  "variants": {
    "style": {
      "description": "The visual style of the navigation links.",
      "options": {
        "underline": {
          "description": "Underline links have no horizontal padding.",
          "anatomy": {
            "root": {
              "parts": {
                "link": {
                  "tokens": {
                    "padding.x": "{az.spacing.0}"
                  }
                }
              }
            }
          }
        },
        "utility": {
          "description": "Utility links have no link padding.",
          "anatomy": {
            "root": {
              "parts": {
                "link": {
                  "tokens": {
                    "padding.x": "{az.spacing.0}",
                    "padding.y": "{az.spacing.0}"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
