{
  "name": "@az-digital/storybook-addon-libraries",
  "private": true,
  "description": "Storybook addon that registers component libraries, switches story rendering, and reports story-associated design contract tests.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./preset": "./src/preset.js",
    "./manager": "./src/manager.tsx",
    "./preview": "./src/preview.ts",
    "./design-contracts": "./src/design-contracts/index.ts",
    "./node": {
      "types": "./src/node/discover.d.ts",
      "import": "./src/node/discover.js"
    },
    "./library.schema.json": "./library.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "library.schema.json",
    "README.md"
  ],
  "keywords": [
    "storybook-addon",
    "design-system",
    "component-library"
  ],
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "peerDependencies": {
    "@az-digital/design-contract-testing": "*",
    "@storybook/addon-docs": "^10.0.0",
    "react": ">=18",
    "storybook": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "@az-digital/design-contract-testing": {
      "optional": true
    }
  }
}
