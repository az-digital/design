{
  "name": "@az-digital/storybook-addon-libraries",
  "version": "0.0.1",
  "private": true,
  "description": "Storybook addon that registers component libraries from their package.json manifests and switches which one the stories render with.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./preset": "./src/preset.js",
    "./manager": "./src/manager.tsx",
    "./preview": "./src/preview.ts",
    "./node": "./src/node/discover.js",
    "./library.schema.json": "./library.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "library.schema.json",
    "README.md"
  ],
  "keywords": [
    "storybook-addon",
    "design-system",
    "component-library"
  ],
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "peerDependencies": {
    "@storybook/addon-docs": "^10.0.0",
    "react": ">=18",
    "storybook": "^10.0.0"
  }
}
