{
  "name": "@az-digital/tokens",
  "version": "0.0.1",
  "description": "Design tokens for Arizona Digital design system.",
  "type": "module",
  "files": [
    "dist"
  ],
  "keywords": [
    "design-tokens",
    "design-system",
    "az-digital"
  ],
  "author": "Arizona Digital",
  "license": "MIT",
  "devDependencies": {
    "@terrazzo/cli": "^2.7.1",
    "@terrazzo/plugin-css": "^2.7.1",
    "@terrazzo/plugin-css-in-js": "^2.7.1"
  },
  "scripts": {
    "generate:arizona-bootstrap-csv": "node scripts/generate-arizona-bootstrap-csv.mjs",
    "generate:arizona-bootstrap-sass-csv": "node scripts/generate-arizona-bootstrap-sass-csv.mjs",
    "generate:arizona-bootstrap-overrides": "node scripts/generate-arizona-bootstrap-overrides.mjs",
    "build": "rm -rf dist && terrazzo build --config terrazzo.config.ts && npm run generate:arizona-bootstrap-csv && npm run generate:arizona-bootstrap-overrides"
  },
  "dependencies": {
    "@terrazzo/plugin-sass": "^2.7.1"
  }
}
