{
  "az": {
    "color": {
      "brand": {
        "red": {
          "$extensions": {
            "com.figma.scopes": [
              "ALL_SCOPES"
            ],
            "com.figma.hiddenFromPublishing": false
          },
          "$type": "color",
          "$value": "#ab0520"
        },
        "blue": {
          "$extensions": {
            "com.figma.scopes": [
              "ALL_SCOPES"
            ],
            "com.figma.hiddenFromPublishing": false
          },
          "$type": "color",
          "$value": "#0c234b"
        },
        "tinta": {
          "$type": "color",
          "$value": "#03132e"
        },
        "azurite": {
          "$extensions": {
            "com.figma.scopes": [
              "ALL_SCOPES"
            ],
            "com.figma.hiddenFromPublishing": false
          },
          "$type": "color",
          "$value": "#1e5288"
        },
        "chili": {
          "$extensions": {
            "com.figma.scopes": [
              "FRAME_FILL",
              "SHAPE_FILL",
              "TEXT_FILL",
              "STROKE_COLOR"
            ],
            "com.figma.hiddenFromPublishing": false
          },
          "$type": "color",
          "$value": "#8b0015"
        },
        "bloom": {
          "$extensions": {
            "com.figma.scopes": [
              "FRAME_FILL",
              "SHAPE_FILL",
              "TEXT_FILL",
              "STROKE_COLOR"
            ],
            "com.figma.hiddenFromPublishing": false
          },
          "$type": "color",
          "$value": "#ef4056"
        },
        "arroyo-blue": {
          "$type": "color",
          "$value": "#106ab1"
        },
        "rain": {
          "$type": "color",
          "$value": "#81ceeb"
        },
        "sonoran-red": {
          "$type": "color",
          "$value": "#850000"
        },
        "bougainvillea": {
          "$type": "color",
          "$value": "#c62840"
        },
        "saguaro": {
          "$type": "color",
          "$value": "#7f8b5a"
        },
        "shade": {
          "$type": "color",
          "$value": "#3f7a7a"
        },
        "brick": {
          "$type": "color",
          "$value": "#85372b"
        },
        "cloud": {
          "$type": "color",
          "$value": "#e5eff7"
        },
        "caliche": {
          "$type": "color",
          "$value": "#f2efea"
        },
        "white": {
          "$type": "color",
          "$value": "#ffffff"
        }
      },
      "semantic": {
        "action": {
          "default": {
            "$type": "color",
            "$value": "{az.color.brand.red}",
            "$description": "Primary action color, resting state (solid fill; outline border and label) \u2014 aliases the brand palette."
          },
          "hover": {
            "$type": "color",
            "$value": "{az.color.brand.chili}",
            "$description": "Primary action color, hover state \u2014 aliases the brand palette."
          },
          "focus-ring": {
            "$type": "color",
            "$value": "{az.color.brand.bloom}",
            "$description": "Focus-visible ring color for actions \u2014 aliases the brand palette."
          }
        }
      }
    },
    "dimension": {
      "2": {
        "$type": "dimension",
        "$value": { "value": 2, "unit": "px" }
      },
      "4": {
        "$type": "dimension",
        "$value": { "value": 4, "unit": "px" }
      },
      "8": {
        "$type": "dimension",
        "$value": { "value": 8, "unit": "px" }
      },
      "12": {
        "$type": "dimension",
        "$value": { "value": 12, "unit": "px" }
      },
      "14": {
        "$type": "dimension",
        "$value": { "value": 14, "unit": "px" }
      },
      "18": {
        "$type": "dimension",
        "$value": { "value": 18, "unit": "px" }
      },
      "22": {
        "$type": "dimension",
        "$value": { "value": 22, "unit": "px" }
      },
      "24": {
        "$type": "dimension",
        "$value": { "value": 24, "unit": "px" }
      },
      "30": {
        "$type": "dimension",
        "$value": { "value": 30, "unit": "px" }
      },
      "36": {
        "$type": "dimension",
        "$value": { "value": 36, "unit": "px" }
      }
    },
    "font-weight": {
      "700": {
        "$type": "number",
        "$value": 700
      }
    },
    "opacity": {
      "65": {
        "$type": "number",
        "$value": 0.65,
        "$description": "65%."
      }
    },
    "component": {
      "button": {
        "label": {
          "font": {
            "size": {
              "$extensions": {
                "com.figma.scopes": [
                  "FONT_SIZE"
                ],
                "com.figma.hiddenFromPublishing": false
              },
              "$type": "dimension",
              "$value": "{az.dimension.18}",
              "$description": "Button label (text) size at the default size, for every style. size.sm and size.lg replace it."
            },
            "weight": {
              "$extensions": {
                "com.figma.scopes": [
                  "FONT_WEIGHT"
                ],
                "com.figma.hiddenFromPublishing": false
              },
              "$type": "number",
              "$value": "{az.font-weight.700}",
              "$description": "Button label (text) weight (Bold), for every style and size."
            }
          }
        },
        "padding": {
          "x": {
            "$extensions": {
              "com.figma.scopes": [
                "WIDTH_HEIGHT"
              ],
              "com.figma.hiddenFromPublishing": false
            },
            "$type": "dimension",
            "$value": "{az.dimension.30}",
            "$description": "Horizontal space between the button's edge and its label at the default size. size.sm and size.lg replace it."
          },
          "y": {
            "$extensions": {
              "com.figma.scopes": [
                "WIDTH_HEIGHT"
              ],
              "com.figma.hiddenFromPublishing": false
            },
            "$type": "dimension",
            "$value": "{az.dimension.12}",
            "$description": "Vertical space between the button's edge and its label at the default size. size.sm and size.lg replace it."
          }
        },
        "border": {
          "width": {
            "$extensions": {
              "com.figma.scopes": [
                "STROKE_FLOAT"
              ],
              "com.figma.hiddenFromPublishing": false
            },
            "$type": "dimension",
            "$value": "{az.dimension.2}",
            "$description": "Button border thickness, for every style and size. Solid buttons draw it in their fill color; outline buttons in outline.border.color."
          },
          "radius": {
            "$extensions": {
              "com.figma.scopes": [
                "CORNER_RADIUS"
              ],
              "com.figma.hiddenFromPublishing": false
            },
            "$type": "dimension",
            "$value": "{az.dimension.24}",
            "$description": "Button corner rounding at the default size, for every style: large enough to give buttons their pill shape. size.lg replaces it."
          }
        },
        "disabled": {
          "opacity": {
            "$extensions": {
              "com.figma.scopes": [
                "OPACITY"
              ],
              "com.figma.hiddenFromPublishing": false
            },
            "$type": "number",
            "$value": "{az.opacity.65}",
            "$description": "Opacity applied to the whole button while disabled, for every style."
          }
        },
        "focus-visible": {
          "ring": {
            "$extensions": {
              "com.figma.scopes": [
                "STROKE_COLOR"
              ],
              "com.figma.hiddenFromPublishing": false
            },
            "$type": "color",
            "$value": "{az.color.semantic.action.focus-ring}",
            "$description": "Button's focus-visible ring color on light surfaces, shared by every style: the one property exclusive to focus-visible (keyboard) focus; plain focus looks identical to hover."
          }
        },
        "size": {
          "sm": {
            "padding": {
              "x": {
                "$extensions": {
                  "com.figma.scopes": [
                    "WIDTH_HEIGHT"
                  ],
                  "com.figma.hiddenFromPublishing": false
                },
                "$type": "dimension",
                "$value": "{az.dimension.8}",
                "$description": "Horizontal padding for small buttons (size sm), replacing padding.x."
              },
              "y": {
                "$extensions": {
                  "com.figma.scopes": [
                    "WIDTH_HEIGHT"
                  ],
                  "com.figma.hiddenFromPublishing": false
                },
                "$type": "dimension",
                "$value": "{az.dimension.4}",
                "$description": "Vertical padding for small buttons (size sm), replacing padding.y."
              }
            },
            "label": {
              "font": {
                "size": {
                  "$extensions": {
                    "com.figma.scopes": [
                      "FONT_SIZE"
                    ],
                    "com.figma.hiddenFromPublishing": false
                  },
                  "$type": "dimension",
                  "$value": "{az.dimension.14}",
                  "$description": "Label (text) size for small buttons (size sm), replacing label.font.size."
                }
              }
            }
          },
          "lg": {
            "padding": {
              "x": {
                "$extensions": {
                  "com.figma.scopes": [
                    "WIDTH_HEIGHT"
                  ],
                  "com.figma.hiddenFromPublishing": false
                },
                "$type": "dimension",
                "$value": "{az.dimension.36}",
                "$description": "Horizontal padding for large buttons (size lg), replacing padding.x."
              },
              "y": {
                "$extensions": {
                  "com.figma.scopes": [
                    "WIDTH_HEIGHT"
                  ],
                  "com.figma.hiddenFromPublishing": false
                },
                "$type": "dimension",
                "$value": "{az.dimension.14}",
                "$description": "Vertical padding for large buttons (size lg), replacing padding.y."
              }
            },
            "label": {
              "font": {
                "size": {
                  "$extensions": {
                    "com.figma.scopes": [
                      "FONT_SIZE"
                    ],
                    "com.figma.hiddenFromPublishing": false
                  },
                  "$type": "dimension",
                  "$value": "{az.dimension.22}",
                  "$description": "Label (text) size for large buttons (size lg), replacing label.font.size."
                }
              }
            },
            "border": {
              "radius": {
                "$extensions": {
                  "com.figma.scopes": [
                    "CORNER_RADIUS"
                  ],
                  "com.figma.hiddenFromPublishing": false
                },
                "$type": "dimension",
                "$value": "{az.dimension.30}",
                "$description": "Corner rounding for large buttons (size lg), replacing border.radius."
              }
            }
          }
        },
        "solid": {
          "container": {
            "color": {
              "$extensions": {
                "com.figma.scopes": [
                  "FRAME_FILL",
                  "SHAPE_FILL"
                ],
                "com.figma.hiddenFromPublishing": false
              },
              "$type": "color",
              "$value": "{az.color.semantic.action.default}",
              "$description": "Solid button's container (fill) color, resting state."
            }
          },
          "label": {
            "color": {
              "$extensions": {
                "com.figma.scopes": [
                  "TEXT_FILL"
                ],
                "com.figma.hiddenFromPublishing": false
              },
              "$type": "color",
              "$value": "{az.color.brand.white}",
              "$description": "Solid button's label (text) color. Same across default/hover/focus."
            }
          },
          "hover": {
            "container": {
              "color": {
                "$extensions": {
                  "com.figma.scopes": [
                    "FRAME_FILL",
                    "SHAPE_FILL"
                  ],
                  "com.figma.hiddenFromPublishing": false
                },
                "$type": "color",
                "$value": "{az.color.semantic.action.hover}",
                "$description": "Solid button's container (fill) color, hover state."
              }
            }
          },
          "focus": {
            "container": {
              "color": {
                "$extensions": {
                  "com.figma.scopes": [
                    "FRAME_FILL",
                    "SHAPE_FILL"
                  ],
                  "com.figma.hiddenFromPublishing": false
                },
                "$type": "color",
                "$value": "{az.component.button.solid.container.color}",
                "$description": "Solid button's container (fill) color, focus state. Aliases solid.container.color directly: a focused solid button keeps its resting fill, and focus-visible adds the ring."
              }
            }
          }
        },
        "outline": {
          "border": {
            "color": {
              "$extensions": {
                "com.figma.scopes": [
                  "STROKE_COLOR"
                ],
                "com.figma.hiddenFromPublishing": false
              },
              "$type": "color",
              "$value": "{az.color.semantic.action.default}",
              "$description": "Outline button's border color, resting state. The container has no fill until hover."
            }
          },
          "label": {
            "color": {
              "$extensions": {
                "com.figma.scopes": [
                  "TEXT_FILL"
                ],
                "com.figma.hiddenFromPublishing": false
              },
              "$type": "color",
              "$value": "{az.color.semantic.action.default}",
              "$description": "Outline button's label (text) color, resting state."
            }
          },
          "hover": {
            "container": {
              "color": {
                "$extensions": {
                  "com.figma.scopes": [
                    "FRAME_FILL",
                    "SHAPE_FILL"
                  ],
                  "com.figma.hiddenFromPublishing": false
                },
                "$type": "color",
                "$value": "{az.color.semantic.action.default}",
                "$description": "Outline button's container (fill) color, hover state: fills with the resting action color."
              }
            },
            "border": {
              "color": {
                "$extensions": {
                  "com.figma.scopes": [
                    "STROKE_COLOR"
                  ],
                  "com.figma.hiddenFromPublishing": false
                },
                "$type": "color",
                "$value": "{az.color.semantic.action.default}",
                "$description": "Outline button's border color, hover state. Unchanged from resting; matches the new fill."
              }
            },
            "label": {
              "color": {
                "$extensions": {
                  "com.figma.scopes": [
                    "TEXT_FILL"
                  ],
                  "com.figma.hiddenFromPublishing": false
                },
                "$type": "color",
                "$value": "{az.color.brand.white}",
                "$description": "Outline button's label (text) color, hover state, on the filled container."
              }
            }
          },
          "focus": {
            "container": {
              "color": {
                "$extensions": {
                  "com.figma.scopes": [
                    "FRAME_FILL",
                    "SHAPE_FILL"
                  ],
                  "com.figma.hiddenFromPublishing": false
                },
                "$type": "color",
                "$value": "{az.component.button.outline.hover.container.color}",
                "$description": "Outline button's container (fill) color, focus state. Aliases outline.hover: focus (any means) always looks identical to hover."
              }
            },
            "border": {
              "color": {
                "$extensions": {
                  "com.figma.scopes": [
                    "STROKE_COLOR"
                  ],
                  "com.figma.hiddenFromPublishing": false
                },
                "$type": "color",
                "$value": "{az.component.button.outline.hover.border.color}",
                "$description": "Outline button's border color, focus state. Aliases outline.hover: focus (any means) always looks identical to hover."
              }
            },
            "label": {
              "color": {
                "$extensions": {
                  "com.figma.scopes": [
                    "TEXT_FILL"
                  ],
                  "com.figma.hiddenFromPublishing": false
                },
                "$type": "color",
                "$value": "{az.component.button.outline.hover.label.color}",
                "$description": "Outline button's label (text) color, focus state. Aliases outline.hover: focus (any means) always looks identical to hover."
              }
            }
          }
        }
      }
    }
  },
  "$themes": [],
  "$metadata": {
    "tokenSetOrder": [
      "az"
    ]
  }
}
