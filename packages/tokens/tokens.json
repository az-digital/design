{
  "az": {
    "color": {
      "brand": {
        "red": {
          "$type": "color",
          "$value": "#AB0520"
        },
        "blue": {
          "$type": "color",
          "$value": "#0C234B"
        },
        "azurite": {
          "$type": "color",
          "$value": "#1E5288"
        }
      }
    },
    "component": {
      "button": {
        "color": {
          "red": {
            "$type": "color",
            "$value": "{az.color.brand.red}",
            "$description": "Brand color used by the Button component's `red` variant."
          },
          "blue": {
            "$type": "color",
            "$value": "{az.color.brand.blue}",
            "$description": "Brand color used by the Button component's `blue` variant."
          }
        },
        "padding": {
          "x": {
            "$type": "dimension",
            "$value": {
              "value": 1.25,
              "unit": "rem"
            },
            "$description": "Button's default horizontal padding."
          },
          "y": {
            "$type": "dimension",
            "$value": {
              "value": 0.5,
              "unit": "rem"
            },
            "$description": "Button's default vertical padding."
          }
        },
        "font": {
          "size": {
            "$type": "dimension",
            "$value": {
              "value": 1,
              "unit": "rem"
            },
            "$description": "Button's default font size."
          },
          "weight": {
            "$type": "fontWeight",
            "$value": 500,
            "$description": "Button's font weight."
          }
        },
        "border": {
          "width": {
            "$type": "dimension",
            "$value": {
              "value": 2,
              "unit": "px"
            },
            "$description": "Button's border width."
          },
          "radius": {
            "$type": "dimension",
            "$value": {
              "value": 3,
              "unit": "rem"
            },
            "$description": "Button's border radius (pill-shaped)."
          }
        },
        "disabled": {
          "opacity": {
            "$type": "number",
            "$value": 0.65,
            "$description": "Button's opacity when disabled."
          }
        },
        "size": {
          "sm": {
            "padding": {
              "x": {
                "$type": "dimension",
                "$value": {
                  "value": 0.5,
                  "unit": "rem"
                },
                "$description": "Small button's horizontal padding."
              },
              "y": {
                "$type": "dimension",
                "$value": {
                  "value": 0.25,
                  "unit": "rem"
                },
                "$description": "Small button's vertical padding."
              }
            },
            "font": {
              "size": {
                "$type": "dimension",
                "$value": {
                  "value": 0.875,
                  "unit": "rem"
                },
                "$description": "Small button's font size."
              }
            }
          },
          "lg": {
            "padding": {
              "x": {
                "$type": "dimension",
                "$value": {
                  "value": 1,
                  "unit": "rem"
                },
                "$description": "Large button's horizontal padding."
              },
              "y": {
                "$type": "dimension",
                "$value": {
                  "value": 0.5,
                  "unit": "rem"
                },
                "$description": "Large button's vertical padding."
              }
            },
            "font": {
              "size": {
                "$type": "dimension",
                "$value": {
                  "value": 1.25,
                  "unit": "rem"
                },
                "$description": "Large button's font size."
              }
            }
          }
        }
      }
    }
  },
  "$themes": [],
  "$metadata": {
    "tokenSetOrder": [
      "az"
    ]
  }
}
