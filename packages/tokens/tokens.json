              },
              "easing": {
                "$type": "cubicBezier",
                "$value": "{az.easing.linear}",
                "$description": "Easing for the off-canvas backdrop's fade. Not yet reviewed by design. Turned off when someone asks for reduced motion."
              }
            }
          }
        }
      },
