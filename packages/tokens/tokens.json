          "width": {
            "$type": "dimension",
            "$value": {
              "value": 211,
              "unit": "px"
            },
            "$description": "Wordmark width below the sm breakpoint (576px)."
          },
          "height": {
            "$type": "dimension",
            "$value": {
              "value": 16,
              "unit": "px"
            },
            "$description": "Wordmark height below the sm breakpoint (576px)."
