              "com.figma.hiddenFromPublishing": false
            },
            "$type": "color",
            "$value": "{az.color.semantic.action.hover}",
            "$description": "Button's container color, hover state."
          }
        },
        "focus": {
          "color": {
            "$extensions": {
              "com.figma.scopes": [
                "FRAME_FILL",
                "SHAPE_FILL",
                "TEXT_FILL",
                "STROKE_COLOR"
              ],
              "com.figma.hiddenFromPublishing": false
            },
            "$type": "color",
            "$value": "{az.component.button.hover.color}",
            "$description": "Button's container color, focus state \u2014 aliases hover.color directly: focus (any means) always looks identical to hover."
          }
        },
        "focus-visible": {
          "ring": {
            "$extensions": {
              "com.figma.scopes": [
                "STROKE_COLOR"
              ],
              "com.figma.hiddenFromPublishing": false
            },
            "$type": "color",
            "$value": "{az.color.semantic.action.focus-ring}",
            "$description": "Button's focus-visible ring color \u2014 the one property exclusive to focus-visible (keyboard) focus; plain focus looks identical to hover."
          }
        },
        "padding": {
          "x": {
            "$extensions": {
              "com.figma.scopes": [
