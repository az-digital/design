              0.4392156862745098,
              0.4392156862745098,
              0.4392156862745098
            ],
            "alpha": 0.5,
            "hex": "#707070"
          },
          "$description": "Neutral gray (#707070) at 50% opacity. Not a brand color: a neutral for rules and dividers."
        }
      },
      "semantic": {
        "surface": {
          "brand": {
            "$type": "color",
            "$value": "{az.color.brand.blue}",
            "$description": "The brand surface: the surface that follows the brand, such as the Arizona Header's fill. Blue by default; a theme can point it at another primary color, such as Red for the original red header. Repoint on-brand.* with it \u2014 aliases the brand palette."
          },
          "default": {
            "$type": "color",
            "$value": "{az.color.brand.white}",
            "$description": "The default surface: the page background most content sits on, such as a breadcrumb's fill. Use on-default.* for what sits on it \u2014 aliases the brand palette."
          }
        },
        "on-brand": {
          "default": {
            "$type": "color",
            "$value": "{az.color.brand.white}",
            "$description": "Text and icons on surface.brand. Repoint it whenever a theme repoints surface.brand \u2014 aliases the brand palette."
          },
          "border": {
            "$type": "color",
            "$value": "{az.color.brand.white}",
            "$description": "Borders and dividers on surface.brand, such as a form field's outline. Repoint it whenever a theme repoints surface.brand \u2014 aliases the brand palette."
          },
          "placeholder": {
            "$type": "color",
            "$value": "{az.color.brand.white}",
            "$description": "Placeholder text in form fields on surface.brand. Repoint it whenever a theme repoints surface.brand \u2014 aliases the brand palette."
          },
          "accent": {
            "$type": "color",
            "$value": "{az.color.brand.rain}",
            "$description": "Accent for hover and focus on surface.brand, such as a form field's border while it has focus. Repoint it whenever a theme repoints surface.brand \u2014 aliases the brand palette."
          },
          "focus-ring": {
            "$type": "color",
            "$value": "{az.color.brand.white}",
            "$description": "Keyboard focus ring on surface.brand. Repoint it whenever a theme repoints surface.brand \u2014 aliases the brand palette."
          },
          "logo": {
            "$type": "color",
            "$value": "{az.color.brand.white}",
            "$description": "Logo color on surface.brand, such as the Arizona Header's wordmark. Separate from on-brand.default because a logo's color is its own brand decision: it can't follow every change to text color. Repoint it whenever a theme repoints surface.brand \u2014 aliases the brand palette."
          }
        },
        "on-default": {
          "link": {
            "$type": "color",
            "$value": "{az.color.brand.red}",
            "$description": "Ordinary links on surface.default, such as a link in running text or an accordion's Copy link \u2014 aliases the brand palette."
          },
          "link-hover": {
            "$type": "color",
            "$value": "{az.color.brand.sonoran-red}",
            "$description": "Ordinary links on surface.default, on hover \u2014 aliases the brand palette."
          },
          "link-supporting": {
            "$type": "color",
            "$value": "{az.color.brand.azurite}",
            "$description": "Supporting links and controls on surface.default, which back up ordinary links rather than compete with them, such as a breadcrumb's links and home icon or an accordion's titles \u2014 aliases the brand palette."
          },
          "link-supporting-hover": {
            "$type": "color",
            "$value": "{az.color.brand.blue}",
            "$description": "Supporting links and controls on surface.default on hover, or while open, such as an accordion's title \u2014 aliases the brand palette."
          },
          "accent": {
            "$type": "color",
            "$value": "{az.color.brand.bougainvillea}",
            "$description": "Accent on surface.default, such as the dividers between breadcrumb items \u2014 aliases the brand palette."
          },
          "border": {
            "$type": "color",
            "$value": "{az.color.neutral.gray-alpha-50}",
            "$description": "Rules and dividers on surface.default, such as the line under each accordion title \u2014 aliases a neutral color."
          },
          "focus-ring": {
            "$type": "color",
            "$value": "{az.color.brand.bougainvillea}",
            "$description": "Keyboard focus ring on surface.default \u2014 aliases the brand palette."
          }
        }
      }
