      "button": {
        "color": {
          "$extensions": {
            "com.figma.scopes": [
              "FRAME_FILL",
              "SHAPE_FILL",
              "TEXT_FILL",
              "STROKE_COLOR"
            ],
            "com.figma.hiddenFromPublishing": false
          },
          "$type": "color",
          "$value": "{az.color.semantic.action.default}",
          "$description": "Button's container color, resting state."
        },
        "label": {
          "color": {
            "$extensions": {
              "com.figma.scopes": [
                "TEXT_FILL"
              ],
              "com.figma.hiddenFromPublishing": false
            },
            "$type": "color",
            "$value": "{az.color.brand.white}",
            "$description": "Button's label (text) color. Same across default/hover/focus \u2014 no state-based variation exists yet."
          },
          "font": {
            "size": {
              "$extensions": {
                "com.figma.scopes": [
                  "FONT_SIZE"
                ],
                "com.figma.hiddenFromPublishing": false
              },
              "$type": "number",
              "$value": "{az.dimension.16}",
              "$description": "az.component.button.label.font.size = 1rem"
            },
            "weight": {
              "$extensions": {
                "com.figma.scopes": [
                  "FONT_WEIGHT"
                ],
                "com.figma.hiddenFromPublishing": false
              },
              "$type": "number",
              "$value": "{az.font-weight.500}",
