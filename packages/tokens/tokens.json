            "width": {
              "$type": "dimension",
              "$value": {
                "value": 266.41,
                "unit": "px"
              },
              "$description": "Wordmark width from the sm breakpoint (576px) up."
            },
            "height": {
              "$type": "dimension",
              "$value": {
                "value": 19.8,
                "unit": "px"
              },
              "$description": "Wordmark height from the sm breakpoint (576px) up."
