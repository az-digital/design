            },
            "line-height": {
              "$type": "dimension",
              "$value": "{az.dimension.10}",
              "$description": "Header button label line height."
            }
          },
          "icon": {
            "size": {
              "$type": "dimension",
              "$value": "{az.dimension.24}",
              "$description": "Header button icon width and height: the icon is 24px square, whether it's an SVG, a sprite or a font glyph."
            },
            "color": {
              "$type": "color",
              "$value": "{az.component.brand-header.button.label.color}",
              "$description": "Header button icon color: the same as the label, so icons and text change together. An SVG icon picks it up through fill=\"currentColor\"."
            }
          },
          "gap": {
            "$type": "dimension",
            "$value": "{az.dimension.2}",
            "$description": "Space between a header button's icon and its label."
          },
          "padding": {
            "y": {
              "$type": "dimension",
              "$value": "{az.dimension.4}",
              "$description": "Header button top and bottom padding."
            }
          },
          "min-width": {
            "$type": "dimension",
            "$value": "{az.dimension.60}",
            "$description": "Header button minimum width."
          },
          "min-height": {
            "$type": "dimension",
            "$value": "{az.component.brand-header.height}",
            "$description": "Header button minimum height: the header's own height."
          },
          "transition": {
            "duration": {
              "$type": "duration",
              "$value": "{az.duration.150}",
              "$description": "How long a header button's colors and focus ring take to change. Not yet reviewed by design. Turned off when someone asks for reduced motion."
            },
            "easing": {
              "$type": "cubicBezier",
              "$value": "{az.easing.ease-in-out}",
              "$description": "Easing for a header button's color and focus ring changes. Not yet reviewed by design. Turned off when someone asks for reduced motion."
            }
          }
        },
        "fixed-on-mobile": {
          "scroll-offset": {
            "$type": "dimension",
            "$value": "{az.dimension.58}",
            "$description": "When the header is fixed on mobile (below 992px): how far below the top of the screen linked sections stop when scrolled to, so the header doesn't cover them."
          }
        },
        "offcanvas": {
          "transition": {
            "duration": {
              "$type": "duration",
