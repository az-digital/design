{
  "az": {
    "color": {
      "brand": {
        "red": {
          "$extensions": {
            "com.figma.scopes": [
              "ALL_SCOPES"
            ],
            "com.figma.hiddenFromPublishing": false
          },
          "$type": "color",
          "$value": "#ab0520"
        },
        "blue": {
          "$extensions": {
            "com.figma.scopes": [
              "ALL_SCOPES"
            ],
            "com.figma.hiddenFromPublishing": false
          },
          "$type": "color",
          "$value": "#0c234b"
        },
        "tinta": {
          "$type": "color",
          "$value": "#03132e"
        },
        "azurite": {
          "$extensions": {
            "com.figma.scopes": [
              "ALL_SCOPES"
            ],
            "com.figma.hiddenFromPublishing": false
          },
          "$type": "color",
          "$value": "#1e5288"
        },
        "chili": {
          "$extensions": {
            "com.figma.scopes": [
              "FRAME_FILL",
              "SHAPE_FILL",
              "TEXT_FILL",
              "STROKE_COLOR"
            ],
            "com.figma.hiddenFromPublishing": false
          },
          "$type": "color",
          "$value": "#8b0015"
        },
        "bloom": {
          "$extensions": {
            "com.figma.scopes": [
              "FRAME_FILL",
              "SHAPE_FILL",
              "TEXT_FILL",
              "STROKE_COLOR"
            ],
            "com.figma.hiddenFromPublishing": false
          },
          "$type": "color",
          "$value": "#ef4056"
        },
        "arroyo-blue": {
          "$type": "color",
          "$value": "#106ab1"
        },
        "rain": {
          "$type": "color",
          "$value": "#81ceeb"
        },
        "sonoran-red": {
          "$type": "color",
          "$value": "#850000"
        },
        "bougainvillea": {
          "$type": "color",
          "$value": "#c62840"
        },
        "saguaro": {
          "$type": "color",
          "$value": "#7f8b5a"
        },
        "shade": {
          "$type": "color",
          "$value": "#3f7a7a"
        },
        "brick": {
          "$type": "color",
          "$value": "#85372b"
        },
        "cloud": {
          "$type": "color",
          "$value": "#e5eff7"
        },
        "caliche": {
          "$type": "color",
          "$value": "#f2efea"
        },
        "white": {
          "$type": "color",
          "$value": "#ffffff"
        }
      },
      "semantic": {
        "action": {
          "default": {
            "$type": "color",
            "$value": "{az.color.brand.red}",
            "$description": "Primary action color, resting state (solid fill; outline border and label) \u2014 aliases the brand palette."
          },
          "hover": {
            "$type": "color",
            "$value": "{az.color.brand.chili}",
            "$description": "Primary action color, hover state \u2014 aliases the brand palette."
          },
          "focus-ring": {
            "$type": "color",
            "$value": "{az.color.brand.bloom}",
            "$description": "Focus-visible ring color for actions \u2014 aliases the brand palette."
          }
        }
      }
    },
    "dimension": {
      "2": {
        "$type": "dimension",
        "$value": { "value": 2, "unit": "px" }
      },
      "4": {
        "$type": "dimension",
        "$value": { "value": 4, "unit": "px" }
      },
      "8": {
        "$type": "dimension",
        "$value": { "value": 8, "unit": "px" }
      },
      "14": {
        "$type": "dimension",
        "$value": { "value": 14, "unit": "px" }
      },
      "16": {
        "$type": "dimension",
        "$value": { "value": 16, "unit": "px" }
      },
      "20": {
        "$type": "dimension",
        "$value": { "value": 20, "unit": "px" }
      },
      "48": {
        "$type": "dimension",
        "$value": { "value": 48, "unit": "px" }
      }
    },
    "font-weight": {
      "500": {
        "$type": "number",
        "$value": 500
      }
    },
    "opacity": {
      "65": {
        "$type": "number",
        "$value": 0.65,
        "$description": "65%."
      }
    },
    "component": {
      "button": {
        "label": {
          "font": {
            "size": {
              "$extensions": {
                "com.figma.scopes": [
                  "FONT_SIZE"
                ],
                "com.figma.hiddenFromPublishing": false
              },
              "$type": "dimension",
              "$value": "{az.dimension.16}",
              "$description": "az.component.button.label.font.size = 1rem"
            },
            "weight": {
              "$extensions": {
                "com.figma.scopes": [
                  "FONT_WEIGHT"
                ],
                "com.figma.hiddenFromPublishing": false
              },
              "$type": "number",
              "$value": "{az.font-weight.500}",
              "$description": "az.component.button.label.font.weight = 500"
            }
          }
        },
        "padding": {
          "x": {
            "$extensions": {
              "com.figma.scopes": [
                "WIDTH_HEIGHT"
              ],
              "com.figma.hiddenFromPublishing": false
            },
            "$type": "dimension",
            "$value": "{az.dimension.20}",
            "$description": "az.component.button.padding.x = 1.25rem"
          },
          "y": {
            "$extensions": {
              "com.figma.scopes": [
                "WIDTH_HEIGHT"
              ],
              "com.figma.hiddenFromPublishing": false
            },
            "$type": "dimension",
            "$value": "{az.dimension.8}",
            "$description": "az.component.button.padding.y = 0.5rem"
          }
        },
        "border": {
          "width": {
            "$extensions": {
              "com.figma.scopes": [
                "STROKE_FLOAT"
              ],
              "com.figma.hiddenFromPublishing": false
            },
            "$type": "dimension",
            "$value": "{az.dimension.2}",
            "$description": "az.component.button.border.width = 2px"
          },
          "radius": {
            "$extensions": {
              "com.figma.scopes": [
                "CORNER_RADIUS"
              ],
              "com.figma.hiddenFromPublishing": false
            },
            "$type": "dimension",
            "$value": "{az.dimension.48}",
            "$description": "az.component.button.border.radius = 3rem"
          }
        },
        "disabled": {
          "opacity": {
            "$extensions": {
              "com.figma.scopes": [
                "OPACITY"
              ],
              "com.figma.hiddenFromPublishing": false
            },
            "$type": "number",
            "$value": "{az.opacity.65}",
            "$description": "az.component.button.disabled.opacity = 0.65"
          }
        },
        "focus-visible": {
          "ring": {
            "$extensions": {
              "com.figma.scopes": [
                "STROKE_COLOR"
              ],
              "com.figma.hiddenFromPublishing": false
            },
            "$type": "color",
            "$value": "{az.color.semantic.action.focus-ring}",
            "$description": "Button's focus-visible ring color on light surfaces, shared by every style: the one property exclusive to focus-visible (keyboard) focus; plain focus looks identical to hover."
          }
        },
        "size": {
          "sm": {
            "padding": {
              "x": {
                "$extensions": {
                  "com.figma.scopes": [
                    "WIDTH_HEIGHT"
                  ],
                  "com.figma.hiddenFromPublishing": false
                },
                "$type": "dimension",
                "$value": "{az.dimension.8}",
                "$description": "az.component.button.size.sm.padding.x = 0.5rem"
              },
              "y": {
                "$extensions": {
                  "com.figma.scopes": [
                    "WIDTH_HEIGHT"
                  ],
                  "com.figma.hiddenFromPublishing": false
                },
                "$type": "dimension",
                "$value": "{az.dimension.4}",
                "$description": "az.component.button.size.sm.padding.y = 0.25rem"
              }
            },
            "label": {
              "font": {
                "size": {
                  "$extensions": {
                    "com.figma.scopes": [
                      "FONT_SIZE"
                    ],
                    "com.figma.hiddenFromPublishing": false
                  },
                  "$type": "dimension",
                  "$value": "{az.dimension.14}",
                  "$description": "az.component.button.size.sm.label.font.size = 0.875rem"
                }
              }
            }
          },
          "lg": {
            "padding": {
              "x": {
                "$extensions": {
                  "com.figma.scopes": [
                    "WIDTH_HEIGHT"
                  ],
                  "com.figma.hiddenFromPublishing": false
                },
                "$type": "dimension",
                "$value": "{az.dimension.16}",
                "$description": "az.component.button.size.lg.padding.x = 1rem"
              },
              "y": {
                "$extensions": {
                  "com.figma.scopes": [
                    "WIDTH_HEIGHT"
                  ],
                  "com.figma.hiddenFromPublishing": false
                },
                "$type": "dimension",
                "$value": "{az.dimension.8}",
                "$description": "az.component.button.size.lg.padding.y = 0.5rem"
              }
            },
            "label": {
              "font": {
                "size": {
                  "$extensions": {
                    "com.figma.scopes": [
                      "FONT_SIZE"
                    ],
                    "com.figma.hiddenFromPublishing": false
                  },
                  "$type": "dimension",
                  "$value": "{az.dimension.20}",
                  "$description": "az.component.button.size.lg.label.font.size = 1.25rem"
                }
              }
            }
          }
        },
        "solid": {
          "container": {
            "color": {
              "$extensions": {
                "com.figma.scopes": [
                  "FRAME_FILL",
                  "SHAPE_FILL"
                ],
                "com.figma.hiddenFromPublishing": false
              },
              "$type": "color",
              "$value": "{az.color.semantic.action.default}",
              "$description": "Solid button's container (fill) color, resting state."
            }
          },
          "label": {
            "color": {
              "$extensions": {
                "com.figma.scopes": [
                  "TEXT_FILL"
                ],
                "com.figma.hiddenFromPublishing": false
              },
              "$type": "color",
              "$value": "{az.color.brand.white}",
              "$description": "Solid button's label (text) color. Same across default/hover/focus."
            }
          },
          "hover": {
            "container": {
              "color": {
                "$extensions": {
                  "com.figma.scopes": [
                    "FRAME_FILL",
                    "SHAPE_FILL"
                  ],
                  "com.figma.hiddenFromPublishing": false
                },
                "$type": "color",
                "$value": "{az.color.semantic.action.hover}",
                "$description": "Solid button's container (fill) color, hover state."
              }
            }
          },
          "focus": {
            "container": {
              "color": {
                "$extensions": {
                  "com.figma.scopes": [
                    "FRAME_FILL",
                    "SHAPE_FILL"
                  ],
                  "com.figma.hiddenFromPublishing": false
                },
                "$type": "color",
                "$value": "{az.component.button.solid.hover.container.color}",
                "$description": "Solid button's container (fill) color, focus state. Aliases solid.hover.container.color directly: focus (any means) always looks identical to hover."
              }
            }
          }
        },
        "outline": {
          "border": {
            "color": {
              "$extensions": {
                "com.figma.scopes": [
                  "STROKE_COLOR"
                ],
                "com.figma.hiddenFromPublishing": false
              },
              "$type": "color",
              "$value": "{az.color.semantic.action.default}",
              "$description": "Outline button's border color, resting state. The container has no fill until hover."
            }
          },
          "label": {
            "color": {
              "$extensions": {
                "com.figma.scopes": [
                  "TEXT_FILL"
                ],
                "com.figma.hiddenFromPublishing": false
              },
              "$type": "color",
              "$value": "{az.color.semantic.action.default}",
              "$description": "Outline button's label (text) color, resting state."
            }
          },
          "hover": {
            "container": {
              "color": {
                "$extensions": {
                  "com.figma.scopes": [
                    "FRAME_FILL",
                    "SHAPE_FILL"
                  ],
                  "com.figma.hiddenFromPublishing": false
                },
                "$type": "color",
                "$value": "{az.color.semantic.action.default}",
                "$description": "Outline button's container (fill) color, hover state: fills with the resting action color."
              }
            },
            "border": {
              "color": {
                "$extensions": {
                  "com.figma.scopes": [
                    "STROKE_COLOR"
                  ],
                  "com.figma.hiddenFromPublishing": false
                },
                "$type": "color",
                "$value": "{az.color.semantic.action.default}",
                "$description": "Outline button's border color, hover state. Unchanged from resting; matches the new fill."
              }
            },
            "label": {
              "color": {
                "$extensions": {
                  "com.figma.scopes": [
                    "TEXT_FILL"
                  ],
                  "com.figma.hiddenFromPublishing": false
                },
                "$type": "color",
                "$value": "{az.color.brand.white}",
                "$description": "Outline button's label (text) color, hover state, on the filled container."
              }
            }
          },
          "focus": {
            "container": {
              "color": {
                "$extensions": {
                  "com.figma.scopes": [
                    "FRAME_FILL",
                    "SHAPE_FILL"
                  ],
                  "com.figma.hiddenFromPublishing": false
                },
                "$type": "color",
                "$value": "{az.component.button.outline.hover.container.color}",
                "$description": "Outline button's container (fill) color, focus state. Aliases outline.hover: focus (any means) always looks identical to hover."
              }
            },
            "border": {
              "color": {
                "$extensions": {
                  "com.figma.scopes": [
                    "STROKE_COLOR"
                  ],
                  "com.figma.hiddenFromPublishing": false
                },
                "$type": "color",
                "$value": "{az.component.button.outline.hover.border.color}",
                "$description": "Outline button's border color, focus state. Aliases outline.hover: focus (any means) always looks identical to hover."
              }
            },
            "label": {
              "color": {
                "$extensions": {
                  "com.figma.scopes": [
                    "TEXT_FILL"
                  ],
                  "com.figma.hiddenFromPublishing": false
                },
                "$type": "color",
                "$value": "{az.component.button.outline.hover.label.color}",
                "$description": "Outline button's label (text) color, focus state. Aliases outline.hover: focus (any means) always looks identical to hover."
              }
            }
          }
        }
      }
    }
  },
  "$themes": [],
  "$metadata": {
    "tokenSetOrder": [
      "az"
    ]
  }
}
