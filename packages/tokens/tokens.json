{
  "az": {
    "color": {
      "brand": {
        "red": {
          "$type": "color",
          "$value": "#AB0520",
          "$description": "Arizona Red, primary color 1."
        },
        "blue": {
          "$type": "color",
          "$value": "#0C234B",
          "$description": "Arizona Blue, primary color 2."
        },
        "tinta": {
          "$type": "color",
          "$value": "#03132E"
        },
        "azurite": {
          "$type": "color",
          "$value": "#1E5288"
        },
        "arroyo-blue": {
          "$type": "color",
          "$value": "#106AB1"
        },
        "rain": {
          "$type": "color",
          "$value": "#81CEEB"
        },
        "sonoran-red": {
          "$type": "color",
          "$value": "#850000"
        },
        "bougainvillea": {
          "$type": "color",
          "$value": "#C62840"
        },
        "saguaro": {
          "$type": "color",
          "$value": "#7F8B5A"
        },
        "shade": {
          "$type": "color",
          "$value": "#3F7A7A"
        },
        "brick": {
          "$type": "color",
          "$value": "#85372B"
        },
        "cloud": {
          "$type": "color",
          "$value": "#E5EFF7"
        },
        "caliche": {
          "$type": "color",
          "$value": "#F2EFEA"
        },
        "white": {
          "$type": "color",
          "$value": "#FFFFFF"
        }
      }
    },
    "focus-ring": {
      "width": {
        "$type": "dimension",
        "$value": {
          "value": 2,
          "unit": "px"
        },
        "$description": "Width of the keyboard focus ring, everywhere one is drawn: links, buttons, and the header's logo and buttons."
      }
    },
    "component": {
      "input-group": {
        "height": {
          "$type": "dimension",
          "$value": {
            "value": 43,
            "unit": "px"
          },
          "$description": "Height of a text field with an attached button."
        },
        "field": {
          "padding": {
            "x": {
              "$type": "dimension",
              "$value": {
                "value": 12,
                "unit": "px"
              },
              "$description": "Space between the field's left and right edges and its text."
            },
            "y": {
              "$type": "dimension",
              "$value": {
                "value": 6,
                "unit": "px"
              },
              "$description": "Space above and below the field's text."
            }
          },
          "font": {
            "size": {
              "$type": "dimension",
              "$value": {
                "value": 16,
                "unit": "px"
              },
              "$description": "Field text size."
            },
            "weight": {
              "$type": "number",
              "$value": 400,
              "$description": "Field text weight (Regular)."
            }
          },
          "line-height": {
            "$type": "dimension",
            "$value": {
              "value": 22,
              "unit": "px"
            },
            "$description": "Field text line height."
          },
          "color": {
            "$type": "color",
            "$value": "{az.color.brand.white}",
            "$description": "Field text color."
          },
          "placeholder": {
            "color": {
              "$type": "color",
              "$value": "{az.color.brand.white}",
              "$description": "Placeholder text color."
            }
          }
        },
        "button": {
          "padding": {
            "$type": "dimension",
            "$value": {
              "value": 9,
              "unit": "px"
            },
            "$description": "Space around the attached button's icon."
          },
          "icon": {
            "size": {
              "$type": "dimension",
              "$value": {
                "value": 24,
                "unit": "px"
              },
              "$description": "The attached button's icon width and height."
            }
          }
        },
        "border": {
          "width": {
            "$type": "dimension",
            "$value": {
              "value": 2,
              "unit": "px"
            },
            "$description": "Border width around the field and button together."
          },
          "radius": {
            "$type": "dimension",
            "$value": {
              "value": 8,
              "unit": "px"
            },
            "$description": "Corner radius of the field and button together."
          },
          "color": {
            "$type": "color",
            "$value": "{az.color.brand.white}",
            "$description": "Border color, around the field and button."
          }
        },
        "divider": {
          "width": {
            "$type": "dimension",
            "$value": "{az.component.input-group.border.width}",
            "$description": "Width of the line between the field and the button: the same as the border."
          },
          "transition": {
            "duration": {
              "$type": "duration",
              "$value": {
                "value": 150,
                "unit": "ms"
              },
              "$description": "How long the divider's color takes to change when the field gains or loses focus. Not yet reviewed by design. Turned off when someone asks for reduced motion."
            },
            "easing": {
              "$type": "cubicBezier",
              "$value": [
                0.42,
                0,
                0.58,
                1
              ],
              "$description": "Easing for the divider's color change. Not yet reviewed by design. Turned off when someone asks for reduced motion."
            }
          },
          "color": {
            "$type": "color",
            "$value": "{az.color.brand.white}",
            "$description": "Color of the line between the field and button."
          }
        },
        "icon": {
          "color": {
            "$type": "color",
            "$value": "{az.color.brand.white}",
            "$description": "The attached button's icon color."
          }
        },
        "hover": {
          "icon": {
            "color": {
              "$type": "color",
              "$value": "{az.color.brand.rain}",
              "$description": "The attached button's icon color on hover."
            }
          }
        },
        "focus": {
          "border": {
            "color": {
              "$type": "color",
              "$value": "{az.color.brand.rain}",
              "$description": "Border color while the field or button has focus."
            }
          },
          "divider": {
            "color": {
              "$type": "color",
              "$value": "{az.color.brand.rain}",
              "$description": "Divider color while the field or button has focus."
            }
          }
        }
      },
      "search": {
        "max-width": {
          "$type": "dimension",
          "$value": {
            "value": 265,
            "unit": "px"
          },
          "$description": "Search form's maximum width. It's an input group, so its other values come from az.component.input-group."
        },
        "padding": {
          "x": {
            "$type": "dimension",
            "$value": {
              "value": 15,
              "unit": "px"
            },
            "$description": "Space to the left and right of the search form."
          },
          "y": {
            "$type": "dimension",
            "$value": {
              "value": 5,
              "unit": "px"
            },
            "$description": "Space above and below the search form."
          }
        },
        "toggle": {
          "focus-visible": {
            "ring": {
              "color": {
                "$type": "color",
                "$value": "{az.color.brand.rain}",
                "$description": "Keyboard focus ring on the button that shows the search form on small screens."
              },
              "width": {
                "$type": "dimension",
                "$value": {
                  "value": 1,
                  "unit": "px"
                },
                "$description": "Width of that button's keyboard focus ring."
              }
            }
          }
        }
      }
    }
  },
  "$themes": [
    {
      "id": "az_collection",
      "name": "Mode 1",
      "group": "AZ",
      "selectedTokenSets": {
        "az": "enabled"
      }
    }
  ],
  "$metadata": {
    "tokenSetOrder": [
      "az"
    ]
  }
}
