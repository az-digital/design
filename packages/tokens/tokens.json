            },
            "width": {
              "$type": "dimension",
              "$value": "{az.dimension.2}",
              "$description": "Width of the inset keyboard focus ring on the logo and header buttons."
            }
          },
          "border": {
            "radius": {
              "$type": "dimension",
              "$value": "{az.dimension.2}",
              "$description": "Corner radius of the logo and header buttons while they have keyboard focus, so the ring has rounded corners."
            }
          }
        },
        "button": {
          "label": {
            "color": {
              "$type": "color",
              "$value": "{az.color.semantic.on-brand.default}",
